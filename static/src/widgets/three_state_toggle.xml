<templates xml:space="preserve">
    <t t-name="school_management.ThreeStateToggle">
        <div class="o_three_toggle">
<!--             <span> element doesn't have a value attribute by default,ev.target.value is undefined-->
            <span class="badge bg-danger" t-on-click="() => this.toggleState('poor')">
                Poor
            </span>
            <span class="badge bg-warning" t-on-click="() => this.toggleState('average')">
                Average
            </span>
            <span class="badge bg-success" t-on-click="() => this.toggleState('excellent')">
                Excellent
            </span>
        </div>

        <!-- Niche field me selected value show karna -->
        <div class="o_field_widget">
            Selected: <t t-esc="props.record.data.performance_toggle"/>
        </div>


