    <record id="view_school_student_kanban" model="ir.ui.view">
        <field name="name">school.student.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="age"/>
                <field name="enrollment_number"/>
                <field name="class_id"/>
                <field name="gender"/>
                <templates>
                    <!--                    <t t-name="kanban-box">          this is deprecated in odoo-->
                    <t t-name="card">
                        <div class="">
                            <t t-esc="record.name.value"/>
                        </div>
                        <div>
                            <t t-esc="record.enrollment_number.value"/>
                        </div>
                        <div>
                            <t t-esc="record.gender.value"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--    Pivot view for student-->
    <record id="pivot_view_school_management_student" model="ir.ui.view">
        <field name="name">school.management.student.pivot</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <pivot string="Students from pivot view">
                <field name="name" type="row"/>
                <field name="age" type="row"/>
                <field name="dob" type="row"/>
            </pivot>
        </field>
    </record>

