<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    this is the view that will display on the screen-->
    <record id="school_management_class_form_view" model="ir.ui.view">
        <field name="name">school.class.view.form</field>
        <field name="model">school.classes</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="subject_ids" widget="many2many_tags"/>
                        <field name="student_ids" widget="many2many_tags_avatar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--    this is the list view-->
    <record id="school_management_class_list_view" model="ir.ui.view">
        <field name="name">school.classes.view.list</field>
        <field name="model">school.classes</field>
        <field name="arch" type="xml">
            <list string="Your Class Data">
                <field name="name"/>
                <field name="subject_ids" widget="many2many_tags"/>
                <field name="student_ids" widget="many2many_tags_avatar"/>
            </list>
        </field>

    </record>
    <!--    this is the action-->
    <record id="action_school_management_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.classes</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>