<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    this is the view that will display on the screen-->
    <record id="school_management_exam_form_view" model="ir.ui.view">
        <field name="name">school.exam.view.form</field>
        <field name="model">school.exams</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="student_id"/>
                    <group>
                        <field name="subject_id"/>
                        <field name="marks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--    this is the list view-->
    <record id="school_management_exam_list_view" model="ir.ui.view">
        <field name="name">school.exam.view.form</field>
        <field name="model">school.exams</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="marks"/>
            </list>
        </field>
    </record>


<!--    pivot view-->
    <record id="pivot_view_school_management_exams" model="ir.ui.view">
        <field name="name">school.management.exams.pivot</field>
        <field name="model">school.exams</field>
        <field name="arch" type="xml">
            <pivot string="Exam information from pivot view" disable_linking="1">
                <field name="name" type="row"/>
                <field name="student_id" type="col"/>
                <field name="subject_id" type="row"/>
                <field name="marks" type="measure"/>
            </pivot>
        </field>
    </record>

<!--    graph view-->
     <record id="school_management_student_exam_graph" model="ir.ui.view">
            <field name="name">school.management.student.exam.graph</field>
            <field name="model">school.exams</field>
            <field name="arch" type="xml">
                <graph string="Exam Statistics" sample="1">
                    <field name="marks"/>
                    <field name="subject_id"/>
                    <field name="student_id"/>
                </graph>
            </field>
         </record>

