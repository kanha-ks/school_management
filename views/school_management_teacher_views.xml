<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--    form view for teacher-->
    <record id="school_management_teacher_view_form" model="ir.ui.view">
        <field name="name">school.teacher.view.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <!--                   adding the fields-->

                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="employee_id"/>
                        <field name="subject" widget="many2many_tags"/>
                        <field name="email"/>
                        <field name="student_lists" widget="many2one_tags"/>
                        <field name="joining_date" widget="date_order"/>
                        <field name="student_ids" widget="many2many_tags"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!--    list view for teacher-->
    <record id="school_management_teacher_list_view" model="ir.ui.view">
        <field name="name">school.teacher.view.list</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="subject" widget="many2many_tags"/>
                <field name="email"/>
                <field name="student_lists" widget="many2one_tags"  />
                <field name="joining_date" widget="date_order"/>
                <field name="student_ids" widget="many2many_tags_avatar"/>
            </list>
        </field>
    </record>

    <!--  action  for teacher view-->
    <record id="action_school_management_teacher" model="ir.actions.act_window">
        <field name="name">Teacher</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>