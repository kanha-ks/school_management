<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="school_management_result_list_view" model="ir.ui.view">
        <field name="name">school.result.view.list</field>
        <field name="model">school.result</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="marks"/>
                <field name="status" widget="boolean"/>
            </list>
        </field>
    </record>


    <record id="school_management_result_form_view" model="ir.ui.view">
        <field name="name">school.result.view.form</field>
        <field name="model">school.result</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="marks"/>
                        <field name="status" widget="boolean"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_management_result" model="ir.actions.act_window">
        <field name="name">Result</field>
        <field name="res_model">school.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>