<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="school_student_exam_report_template_custom">
        <t>
            <t t-call="web.external_layout">
                <t t-call="web.html_container">

                    <style>
                        body {
                        background-color: #f0f2f5;
                        font-family: Arial, sans-serif;
                        }

                        table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 20px;
                        }

                        th, td {
                        border: 1px solid black;
                        padding: 15px;
                        text-align: center;
                        font-size: 18px;
                        }

                        th {
                        background-color: LightGray;
                        }

                        h1 {
                        color: Gray;
                        margin-top : 20px;
                        }

                        .highlight {
                        color: #e74c3c;
                        font-weight: bold;
                        }
                    </style>

                    <table>
                        <thead>
                            <th>
                                Name
                            </th>
                            <t t-foreach="docs.exam_ids.subject_id" t-as="subj">
                                <th>
                                    <t t-esc="subj.name"/>
                                </th>
                            </t>
                        </thead>

                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td>
                                        <t t-esc="doc.name"/>
                                    </td>
                                    <t t-foreach="doc.exam_ids" t-as="exam">
                                        <td>
                                            <t t-esc="exam.marks"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>

                        </tbody>
                    </table>
                </t>
            </t>
        </t>
    </template>

    <record id="action_school_student_exam_report_template_custom" model="ir.actions.report">
        <field name="name">Task Student Exam Report</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">school_management.school_student_exam_report_template_custom</field>
        <field name="report_file">school_management.school_student_exam_report_template_custom</field>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">report</field>
    </record>
</odoo>